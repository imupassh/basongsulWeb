
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbfaf9">
  <title>자수, 염원을 그리다</title>
  <style>
    :root {
      --ink: #1b1b1b;
      --muted: #535353;
      --paper: #fbfaf9;
      --card: #f0efee;
      --green: #105c55;
      --green-soft: #88cbc2;
      --selected-surface: #e7f2f0;
      --selected-text: #064c48;
      --primary-bg: #105c55;
      --primary-text: #fff;
      --focus: #c5451d;
      --scale: 1;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: system-ui, -apple-system, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
      font-size: calc(18px * var(--scale));
      line-height: 1.55;
    }

    button, input { font: inherit; }
    button { color: inherit; }
    :focus-visible { outline: 4px solid var(--focus); outline-offset: 4px; }

    .sr-only {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }

    .skip-links {
      position: absolute;
      z-index: 20;
      top: 0;
      left: 1rem;
      display: flex;
      gap: .5rem;
      transform: translateY(-150%);
    }

    .skip-links:focus-within { transform: translateY(1rem); }

    .skip-links a {
      padding: .65rem .85rem;
      border: 2px solid #111;
      border-radius: 7px;
      background: #fff;
      color: #111;
      font-weight: 800;
    }

    .wrap {
      width: min(100% - 38px, 760px);
      margin-inline: auto;
    }

    header { padding: 28px 0 4px; }

    h1 {
      margin: 0 0 22px;
      font-size: clamp(2rem, 7vw, 2.7rem);
      line-height: 1.18;
      letter-spacing: -.04em;
    }

    h2 {
      margin: 0;
      font-size: clamp(1.35rem, 5vw, 1.8rem);
      line-height: 1.3;
    }

    h3 { margin: 0; font-size: 1.12rem; }

    .top-tools {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .tool-button {
      min-height: 106px;
      padding: 10px 6px;
      border: 3px solid var(--green);
      border-radius: 27px;
      background: transparent;
      color: var(--green);
      cursor: pointer;
      font-weight: 850;
      line-height: 1.15;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 7px;
    }

    .tool-button.primary {
      background: var(--primary-bg);
      color: var(--primary-text);
    }

    .tool-button svg {
      width: 30px;
      height: 30px;
      fill: currentColor;
      flex: none;
    }

    .tool-button span { font-size: clamp(.8rem, 3.2vw, 1.1rem); }

    .font-and-contrast {
      margin-top: 14px;
      padding: 12px 14px;
      border: 1px solid #c8c5c1;
      border-radius: 14px;
      background: var(--paper);
    }

    .font-and-contrast legend {
      font-size: .83rem;
      font-weight: 800;
      padding: 0 4px;
    }

    .font-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 12px;
    }

    .font-options {
      display: flex;
      flex-wrap: wrap;
      gap: 5px 12px;
    }

    .font-options label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 40px;
      font-size: .82rem;
      cursor: pointer;
    }

    .font-options input {
      width: 20px;
      height: 20px;
      accent-color: var(--green);
    }

    .small-control {
      min-height: 42px;
      padding: 7px 12px;
      border: 1px solid var(--green);
      border-radius: 9px;
      background: var(--paper);
      color: var(--green);
      font-size: .82rem;
      font-weight: 800;
      cursor: pointer;
    }

    .small-control[aria-pressed="true"] {
      background: var(--primary-bg);
      color: var(--primary-text);
    }

    .status {
      min-height: 1.5em;
      margin: 8px 0 0;
      color: var(--muted);
      font-size: .82rem;
    }

    main { padding-bottom: 40px; }
    .original-section { margin-top: 26px; }

    .poster-frame {
      position: relative;
      overflow: hidden;
      border-radius: 29px;
      background: var(--green-soft);
    }

    .poster-image-button {
      display: block;
      width: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .poster-image-button img {
      display: block;
      width: 100%;
      height: auto;
    }

    .speaker-hotspot {
      position: absolute;
      z-index: 2;
      display: grid;
      place-items: center;
      width: clamp(46px, 10vw, 62px);
      height: clamp(46px, 10vw, 62px);
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--primary-bg);
      color: var(--primary-text);
      box-shadow: 0 2px 8px #003c3740;
      cursor: pointer;
    }

    .speaker-hotspot svg, .speaker-small svg {
      width: 25px;
      height: 25px;
      fill: currentColor;
    }

    .speaker-hotspot.room { left: 22%; top: 4%; }
    .speaker-hotspot.logo { right: 2%; top: 7%; }
    .speaker-hotspot.title { left: 66%; top: 34%; }
    .speaker-hotspot.subtitle { left: 70%; top: 47%; }

    .poster-caption {
      margin: 12px 0 0;
      color: var(--muted);
    }

    .poster-caption strong { color: var(--ink); }
    .picker { margin-top: 56px; }

    .picker p {
      margin: 5px 0 16px;
      color: var(--muted);
    }

    .mode-buttons {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .mode-button {
      min-height: 98px;
      padding: 10px 7px;
      border: 2px solid transparent;
      border-radius: 27px;
      background: var(--card);
      cursor: pointer;
      font-weight: 850;
      font-size: clamp(.95rem, 4vw, 1.45rem);
    }

    .mode-button[aria-pressed="true"] {
      border-color: var(--selected-text);
      background: var(--selected-surface);
      color: var(--selected-text);
    }

    .selection-status {
      min-height: 1.5em;
      margin: 12px 0 0;
      color: var(--muted);
      font-size: .88rem;
    }

    .selected-section {
      margin-top: 36px;
      padding-top: 26px;
      border-top: 1px solid #d0ccc7;
    }

    .selected-section[hidden] { display: none; }
    .selected-heading { margin-bottom: 14px; }

    .selected-heading p {
      margin: 4px 0 0;
      color: var(--muted);
    }

    .selected-poster-frame {
      position: relative;
      width: min(100%, 560px);
      margin: 0 auto;
      padding: 10px;
      border-radius: 20px;
      background: #fff;
    }

    .selected-poster-image {
      display: block;
      width: 100%;
      height: auto;
      max-height: 70vh;
      object-fit: contain;
      border-radius: 9px;
    }

    .selected-caption {
      width: min(100%, 560px);
      margin: 8px auto 0;
      color: var(--muted);
      font-size: .88rem;
    }

    .info-section { margin-top: 26px; }

    .info-section > p {
      margin: 5px 0 14px;
      color: var(--muted);
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .info-card {
      min-width: 0;
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      align-items: center;
      gap: 10px;
      padding: 12px 15px;
      border-radius: 23px;
      background: var(--card);
    }

    .speaker-small {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      flex: none;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--primary-bg);
      color: var(--primary-text);
      cursor: pointer;
    }

    .info-details { min-width: 0; }

    .info-details summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      min-height: 58px;
      cursor: pointer;
      list-style: none;
      font-size: 1.03rem;
      font-weight: 850;
    }

    .info-details summary::-webkit-details-marker { display: none; }

    .info-details summary::after {
      content: "+";
      color: var(--green);
      font-size: 1.2rem;
    }

    .info-details[open] summary::after { content: "−"; }
    .info-copy { padding: 0 16px 17px; }

    .info-copy p {
      margin: 0 0 12px;
      overflow-wrap: anywhere;
    }

    .reading-panel {
      margin-top: 22px;
      padding: 18px;
      border-radius: 23px;
      background: var(--primary-bg);
      color: var(--primary-text);
    }

    .reading-panel[hidden] { display: none; }

    .reading-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 7px;
    }

    .reading-state {
      margin: 0;
      color: var(--primary-text);
      font-size: .88rem;
    }

    .reading-pause {
      width: 48px;
      height: 48px;
      flex: none;
      border: 0;
      border-radius: 50%;
      background: var(--primary-text);
      color: var(--primary-bg);
      font-size: .8rem;
      font-weight: 850;
      cursor: pointer;
    }

    .reading-text {
      margin: 0;
      font-size: 1.18rem;
      font-weight: 750;
    }

    .return-link {
      display: inline-block;
      margin-top: 22px;
      font-weight: 800;
      text-underline-offset: 4px;
    }

    dialog {
      width: min(96vw, 900px);
      max-width: none;
      max-height: 94vh;
      padding: 16px;
      border: 0;
      border-radius: 18px;
      background: var(--paper);
      color: var(--ink);
    }

    dialog::backdrop { background: #000d; }

    .dialog-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .dialog-head h2 { font-size: 1.15rem; }

    .dialog-image {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: calc(94vh - 90px);
      margin: auto;
      object-fit: contain;
    }

    footer {
      padding: 20px 0 34px;
      border-top: 1px solid #d0ccc7;
      color: var(--muted);
      font-size: .82rem;
    }

    @media (max-width: 520px) {
      .wrap { width: min(100% - 30px, 760px); }
      header { padding-top: 24px; }
      .top-tools { gap: 8px; }
      .tool-button { min-height: 88px; border-radius: 24px; border-width: 2px; }
      .tool-button svg { width: 25px; height: 25px; }
      .font-and-contrast { padding: 10px; }
      .font-row { align-items: flex-start; }
      .speaker-hotspot { width: 42px; height: 42px; }
      .speaker-hotspot svg { width: 22px; height: 22px; }
      .picker { margin-top: 42px; }
      .mode-buttons { gap: 8px; }
      .mode-button { min-height: 76px; border-radius: 22px; }
      .info-grid { gap: 9px; }
      .info-card { border-radius: 18px; }
      .info-details summary { min-height: 72px; gap: 8px; padding: 10px; font-size: .94rem; }
      .info-card { grid-template-columns: 40px minmax(0, 1fr); gap: 8px; padding: 10px; }
      .speaker-small { width: 40px; height: 40px; }
      .speaker-small svg { width: 21px; height: 21px; }
      .info-copy { padding-inline: 12px; }
    }

    @media (max-width: 360px) {
      .top-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .mode-button { font-size: .9rem; }
      .info-grid { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body>
  <nav class="skip-links" aria-label="빠른 이동">
    <a href="#main-content">본문으로 건너뛰기</a>
    <a href="#mode-picker">보기 방식 선택으로 이동</a>
  </nav>

  <header class="wrap">
    <h1 id="page-title">인터랙티브 포스터</h1>
    <div class="top-tools" role="group" aria-label="읽기와 포스터 보기 기능">
      <button class="tool-button primary" id="read-all" type="button" aria-label="현재 내용 모두 읽기">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        <span>모두 읽기</span>
      </button>
      <button class="tool-button" id="stop-reading" type="button" aria-label="읽기 멈추기">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z"/></svg>
        <span>멈추기</span>
      </button>
      <button class="tool-button" id="speed-button" type="button" aria-label="읽기 속도 보통, 누르면 변경">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5v14l8-7zm9 0v14l8-7z"/></svg>
        <span id="speed-label">빠르기 · 보통</span>
      </button>
      <button class="tool-button" id="zoom-button" type="button" aria-haspopup="dialog" aria-label="현재 포스터 확대">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 2a8 8 0 1 0 4.9 14.3L21 22l1-1-5.7-6.1A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12zm-1 2v3H6v2h3v3h2v-3h3V9h-3V6z"/></svg>
        <span>확대</span>
      </button>
    </div>

    <fieldset class="font-and-contrast">
      <legend>보기 설정</legend>
      <div class="font-row">
        <div class="font-options" role="group" aria-label="글자 크기">
          <label><input type="radio" name="font-size" value="1" checked> 기본</label>
          <label><input type="radio" name="font-size" value="1.18"> 크게</label>
          <label><input type="radio" name="font-size" value="1.36"> 더 크게</label>
        </div>
        <button class="small-control" id="contrast-toggle" type="button" aria-pressed="false">고대비 켜기</button>
      </div>
    </fieldset>

    <p class="status" id="speech-status" role="status" aria-live="polite" aria-atomic="true">스피커 표시를 누르면 해당 부분을 읽어줍니다.</p>
  </header>

  <main class="wrap" id="main-content" tabindex="-1">
    <section class="original-section" aria-labelledby="original-title">
      <h2 class="sr-only" id="original-title">원본 포스터</h2>
      <figure>
        <div class="poster-frame" id="original-frame">
          <button class="poster-image-button" type="button" data-speak="original" aria-label="원본 포스터 전체 그림 설명 듣기">
            <img src="image/original-poster-photo.jpg" alt="민트색 바탕에 자수로 그린 산과 마을 풍경이 펼쳐진 원본 포스터 사진입니다. 중앙 위쪽에 ‘자수, 염원을 그리다’ 제목과 영문 제목이 있습니다.">
          </button>
          <button class="speaker-hotspot room" type="button" data-speak="room" aria-label="전시 장소 표기 읽기">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9zm12.5 3a3.5 3.5 0 0 0-2-3.16v6.32a3.5 3.5 0 0 0 2-3.16zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z"/></svg>
          </button>
          <button class="speaker-hotspot logo" type="button" data-speak="museum" aria-label="서울공예박물관 로고 읽기">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9zm12.5 3a3.5 3.5 0 0 0-2-3.16v6.32a3.5 3.5 0 0 0 2-3.16zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z"/></svg>
          </button>
          <button class="speaker-hotspot title" type="button" data-speak="title" aria-label="전시 제목 읽기">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9zm12.5 3a3.5 3.5 0 0 0-2-3.16v6.32a3.5 3.5 0 0 0 2-3.16zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z"/></svg>
          </button>
          <button class="speaker-hotspot subtitle" type="button" data-speak="english" aria-label="영문 제목 읽기">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9zm12.5 3a3.5 3.5 0 0 0-2-3.16v6.32a3.5 3.5 0 0 0 2-3.16zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z"/></svg>
          </button>
        </div>
        <figcaption class="poster-caption">
          <strong>원본 포스터</strong> · 스피커 표시를 누르면 해당 부분을 소리로 읽어줘요.
        </figcaption>
      </figure>
    </section>

    <section class="picker" id="mode-picker" tabindex="-1" aria-labelledby="picker-title">
      <h2 id="picker-title">보기 방식 바꾸기</h2>
      <div class="mode-buttons" role="group" aria-label="접근 방식별 포스터 선택">
        <button class="mode-button" type="button" data-mode="lowvision" aria-pressed="false" aria-controls="selected-section">약시</button>
        <button class="mode-button" type="button" data-mode="tunnel" aria-pressed="false" aria-controls="selected-section">터널시야</button>
        <button class="mode-button" type="button" data-mode="colorblind" aria-pressed="false" aria-controls="selected-section">색맹</button>
      </div>
      <p class="selection-status" id="selection-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>

    <section class="selected-section" id="selected-section" hidden aria-labelledby="selected-title">
      <div class="selected-heading">
        <h2 id="selected-title"></h2>
        <p id="selected-description"></p>
      </div>
      <figure>
        <div class="selected-poster-frame">
          <button class="poster-image-button" id="selected-image-button" type="button" aria-label="선택한 포스터 그림 설명 듣기">
            <img class="selected-poster-image" id="selected-image" src="image/poster-contrast.png" alt="">
          </button>
        </div>
        <figcaption class="selected-caption" id="selected-caption"></figcaption>
      </figure>
      <section class="info-section" aria-labelledby="info-title">
        <h3 id="info-title">자세한 설명 항목</h3>
        <p>항목을 열어 자세한 내용을 확인하거나 스피커 버튼으로 들을 수 있습니다.</p>
        <div class="info-grid" id="info-grid"></div>
      </section>
      <div class="reading-panel" id="reading-panel" hidden>
        <div class="reading-bar">
          <p class="reading-state" id="reading-state" role="status" aria-live="polite" aria-atomic="true">선택한 정보</p>
          <button class="reading-pause" id="pause-resume" type="button" aria-label="음성 읽기 일시정지">멈춤</button>
        </div>
        <p class="reading-text" id="reading-text"></p>
      </div>
      <a class="return-link" href="#mode-picker">보기 방식 목차로 돌아가기</a>
    </section>
  </main>

  <dialog id="zoom-dialog" aria-labelledby="zoom-title">
    <div class="dialog-head">
      <h2 id="zoom-title">포스터 크게 보기</h2>
      <button class="small-control" id="close-zoom" type="button">닫기</button>
    </div>
    <img class="dialog-image" id="dialog-image" src="image/original-poster-photo.jpg" alt="원본 포스터 전체 이미지">
  </dialog>

  <footer>
    <div class="wrap">
      <p>음성 읽기는 기기의 브라우저 음성 기능을 사용합니다. 소리가 들리지 않으면 기기 음량과 음성 지원 여부를 확인해 주세요.</p>
    </div>
  </footer>

  <script>
    const modes = {
      lowvision: {
        title: '약시를 위한 포스터',
        description: '글자를 키우고 제목과 전시 정보를 눈에 잘 띄게 배치했습니다.',
        image: 'image/poster-contrast.png',
        alt: '민트색 바탕에 큰 검은 글씨로 전시 제목이 있습니다. 가운데에는 붉은색, 남색, 크림색 천 조각으로 표현한 저고리가 있고, 아래쪽에 전시 날짜와 장소가 굵은 글씨로 정리되어 있습니다.',
        caption: '글자 크기와 명암 대비를 높인 포스터입니다.',
        items: [
          ['제목', '자수, 염원을 그리다. 영문 제목은 Embroidered Lives, Enduring Wishes입니다.'],
          ['기간', '상설전시이며 2025년 12월 20일부터입니다.'],
          ['장소', '서울공예박물관 전시3동 2층 전시실입니다.'],
          ['포스터 설명', '민트색 바탕 중앙에 전통 저고리 모양의 그림이 있습니다. 제목은 굵은 검은 글씨로 크고 선명하게 보입니다.']
        ]
      },
      tunnel: {
        title: '터널시야를 고려한 포스터',
        description: '어두운 배경에 밝은 글자를 사용하고 정보를 세로로 배치했습니다.',
        image: 'image/poster-low-vision.png',
        alt: '검은색에 가까운 어두운 바탕의 세로형 포스터입니다. 왼쪽의 세로선과 번호를 따라 제목, 상설전시, 날짜와 장소가 밝은 민트색과 노란색 글씨로 이어집니다.',
        caption: '어두운 배경과 밝은 글자를 사용한 포스터입니다.',
        items: [
          ['제목', '자수, 염원을 그리다.'],
          ['기간', '상설전시이며 2025년 12월 20일부터입니다.'],
          ['장소', '서울공예박물관 전시3동 2층 전시실입니다.'],
          ['포스터 설명', '어두운 바탕 왼쪽에 위에서 아래로 이어지는 선과 번호가 있습니다. 제목은 민트색, 날짜는 노란색으로 강조되어 있습니다.']
        ]
      },
      colorblind: {
        title: '색맹 관람객을 위한 포스터',
        description: '색 외에도 글자와 선, 점무늬로 정보를 구분하도록 구성했습니다.',
        image: 'image/poster-braille.png',
        alt: '민트색 세로형 포스터입니다. 위쪽에는 점자와 가로선, 사선, 점무늬 패턴이 있고, 아래쪽에는 전시 정보와 접힌 병풍 모양의 윤곽이 있습니다.',
        caption: '선과 점무늬, 글자를 함께 사용했고 점자도 넣었습니다.',
        items: [
          ['제목', '자수, 염원을 그리다. 영문 제목은 Embroidered Lives, Enduring Wishes입니다.'],
          ['기간', '상설전시이며 2025년 12월 20일부터입니다.'],
          ['장소', '서울공예박물관 전시3동 2층 전시실입니다.'],
          ['문의', '02-6450-7000입니다.'],
          ['포스터 설명', '위쪽에는 점자와 서로 다른 선·사선·점 패턴이 있습니다. 아래쪽에는 전시 정보와 여러 면으로 접힌 병풍 모양의 윤곽선이 있습니다.']
        ]
      }
    };

    const originalSpeech = {
      original: '원본 포스터입니다. 민트색 바탕 전체에 자수로 그린 산과 마을 풍경이 펼쳐집니다.',
      room: '왼쪽 위에 전시3동 2층 전시실이라고 적혀 있습니다.',
      museum: '오른쪽 위에 서울공예박물관 로고가 있습니다.',
      title: '전시 제목은 자수, 염원을 그리다입니다.',
      english: '영문 제목은 Embroidered Lives, Enduring Wishes입니다.'
    };

    const speechStatus = document.querySelector('#speech-status');
    const zoomDialog = document.querySelector('#zoom-dialog');
    const dialogImage = document.querySelector('#dialog-image');
    const selectedSection = document.querySelector('#selected-section');
    const fontOptions = Array.from(document.querySelectorAll('input[name="font-size"]'));
    let activeMode = null;
    let speechRate = 1;
    let currentText = '';
    let currentLabel = '선택한 정보';
    const rates = [0.8, 1, 1.2, 1.4];
    const rateNames = ['느리게', '보통', '빠르게', '매우 빠르게'];

    function say(text, label = '선택한 정보') {
      currentText = text;
      currentLabel = label;

      if (!('speechSynthesis' in window)) {
        speechStatus.textContent = '이 브라우저에서는 음성 읽기를 지원하지 않습니다. 화면에 표시된 글을 확인해 주세요.';
        return;
      }

      const panel = document.querySelector('#reading-panel');
      if (activeMode) {
        panel.hidden = false;
        document.querySelector('#reading-state').textContent = `지금 읽는 중 · ${label}`;
        document.querySelector('#reading-text').textContent = text;
      }

      window.speechSynthesis.cancel();

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'ko-KR';
      utterance.rate = speechRate;

      utterance.onstart = () => {
        speechStatus.textContent = '읽는 중입니다.';
        if (activeMode) {
          document.querySelector('#reading-state').textContent = `지금 읽는 중 · ${label}`;
        }
      };

      utterance.onend = () => {
        speechStatus.textContent = '읽기가 끝났습니다.';
        if (activeMode) {
          document.querySelector('#reading-state').textContent = '읽기가 끝났습니다.';
        }
      };

      window.speechSynthesis.speak(utterance);
    }

    document.querySelectorAll('[data-speak]').forEach(button => {
      button.addEventListener('click', () => {
        say(originalSpeech[button.dataset.speak], button.getAttribute('aria-label'));
      });
    });

    document.querySelector('#read-all').addEventListener('click', () => {
      const parts = [
        originalSpeech.original,
        originalSpeech.room,
        originalSpeech.museum,
        originalSpeech.title,
        originalSpeech.english
      ];

      if (activeMode) {
        const mode = modes[activeMode];
        parts.push(mode.title, mode.description, ...mode.items.map(([label, value]) => `${label}. ${value}`));
      } else {
        parts.push('아래에서 약시, 터널시야, 색맹을 위한 안내 포스터를 선택할 수 있습니다.');
      }

      say(parts.join(' '), '전체 포스터');
    });

    document.querySelector('#stop-reading').addEventListener('click', () => {
      if ('speechSynthesis' in window) window.speechSynthesis.cancel();
      speechStatus.textContent = '읽기를 멈췄습니다.';
      if (activeMode) document.querySelector('#reading-state').textContent = '읽기를 멈췄습니다.';
    });

    document.querySelector('#pause-resume').addEventListener('click', event => {
      const button = event.currentTarget;

      if ('speechSynthesis' in window && window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
        button.textContent = '멈춤';
        button.setAttribute('aria-label', '음성 읽기 일시정지');
        document.querySelector('#reading-state').textContent = '읽기를 계속합니다.';
      } else if ('speechSynthesis' in window && window.speechSynthesis.speaking) {
        window.speechSynthesis.pause();
        button.textContent = '계속';
        button.setAttribute('aria-label', '음성 읽기 계속하기');
        document.querySelector('#reading-state').textContent = '읽기를 일시정지했습니다.';
      }
    });

    document.querySelector('#speed-button').addEventListener('click', event => {
      const current = rates.indexOf(speechRate);
      const next = (current + 1) % rates.length;
      speechRate = rates[next];

      document.querySelector('#speed-label').textContent = `빠르기 · ${rateNames[next]}`;
      event.currentTarget.setAttribute('aria-label', `읽기 속도 ${rateNames[next]}, 누르면 변경`);

      if ('speechSynthesis' in window && window.speechSynthesis.speaking && currentText) {
        say(currentText, currentLabel);
        speechStatus.textContent = `읽기 속도를 ${rateNames[next]}로 바꾸고 현재 내용을 처음부터 다시 읽습니다.`;
      } else {
        speechStatus.textContent = `읽기 속도를 ${rateNames[next]}로 바꿨습니다. 다음 읽기부터 적용됩니다.`;
      }
    });

    fontOptions.forEach(option => option.addEventListener('change', () => {
      document.documentElement.style.setProperty('--scale', option.value);
    }));

    document.querySelector('#contrast-toggle').addEventListener('click', event => {
      const enabled = event.currentTarget.getAttribute('aria-pressed') !== 'true';
      event.currentTarget.setAttribute('aria-pressed', String(enabled));

      document.documentElement.style.setProperty('--paper', enabled ? '#000' : '#fbfaf9');
      document.documentElement.style.setProperty('--card', enabled ? '#111' : '#f0efee');
      document.documentElement.style.setProperty('--ink', enabled ? '#fff' : '#1b1b1b');
      document.documentElement.style.setProperty('--muted', enabled ? '#eee' : '#535353');
      document.documentElement.style.setProperty('--green', enabled ? '#75eadb' : '#105c55');
      document.documentElement.style.setProperty('--selected-surface', enabled ? '#fff' : '#e7f2f0');
      document.documentElement.style.setProperty('--selected-text', enabled ? '#000' : '#064c48');
      document.documentElement.style.setProperty('--primary-bg', enabled ? '#fff' : '#105c55');
      document.documentElement.style.setProperty('--primary-text', enabled ? '#000' : '#fff');

      event.currentTarget.textContent = enabled ? '고대비 끄기' : '고대비 켜기';
    });

    function updateZoomImage(src, alt) {
      dialogImage.src = src;
      dialogImage.alt = alt;
    }

    document.querySelector('#zoom-button').addEventListener('click', () => {
      if (!activeMode) {
        updateZoomImage('image/original-poster-photo.jpg', '원본 포스터 전체 이미지');
      }
      zoomDialog.showModal();
    });

    document.querySelector('#close-zoom').addEventListener('click', () => zoomDialog.close());
    zoomDialog.addEventListener('click', event => {
      if (event.target === zoomDialog) zoomDialog.close();
    });

    document.querySelector('.poster-image-button[data-speak="original"]').addEventListener('click', () => {
      updateZoomImage('image/original-poster-photo.jpg', '원본 포스터 전체 이미지');
    });

    function renderMode(key) {
      activeMode = key;
      const mode = modes[key];

      selectedSection.hidden = false;
      document.querySelector('#selected-title').textContent = mode.title;
      document.querySelector('#selected-description').textContent = mode.description;

      const image = document.querySelector('#selected-image');
      image.src = mode.image;
      image.alt = mode.alt;
      document.querySelector('#selected-caption').textContent = mode.caption;

      document.querySelectorAll('.mode-button').forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.mode === key));
      });

      const grid = document.querySelector('#info-grid');
      grid.replaceChildren();

      mode.items.forEach(([label, value]) => {
        const card = document.createElement('div');
        card.className = 'info-card';

        const speaker = document.createElement('button');
        speaker.type = 'button';
        speaker.className = 'speaker-small';
        speaker.setAttribute('aria-label', `${label} 정보 읽어주기`);
        speaker.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9zm12.5 3a3.5 3.5 0 0 0-2-3.16v6.32a3.5 3.5 0 0 0 2-3.16zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z"/></svg>';
        speaker.addEventListener('click', () => say(`${label}. ${value}`, label));

        const details = document.createElement('details');
        details.className = 'info-details';

        const summary = document.createElement('summary');
        const name = document.createElement('span');
        name.textContent = label;
        summary.append(name);

        const copy = document.createElement('div');
        copy.className = 'info-copy';

        const text = document.createElement('p');
        text.textContent = value;

        const readButton = document.createElement('button');
        readButton.type = 'button';
        readButton.className = 'small-control';
        readButton.textContent = '이 항목 읽기';
        readButton.setAttribute('aria-label', `${label} 정보 소리로 읽기`);
        readButton.addEventListener('click', () => say(`${label}. ${value}`, label));

        copy.append(text, readButton);
        details.append(summary, copy);
        card.append(speaker, details);
        grid.append(card);
      });

      document.querySelector('#reading-panel').hidden = true;
      speechStatus.textContent = `${mode.title}를 선택했습니다. 내용을 들으려면 스피커 버튼을 누르세요.`;
      document.querySelector('#reading-text').textContent = '';

      updateZoomImage(mode.image, mode.alt);

      if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    }

    document.querySelectorAll('.mode-button').forEach(button => {
      button.addEventListener('click', () => renderMode(button.dataset.mode));
    });

    document.querySelector('#selected-image-button').addEventListener('click', () => {
      const mode = modes[activeMode];
      say(mode.alt, '포스터 설명');
    });
  </script>
</body>
</html>
